{
    "name": "Cobrador Automatico de Impagos · 1 · Recordatorios diarios",
    "flow": [
        {
            "id": 1,
            "module": "google-sheets:filterRows",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 0
            },
            "mapper": {
                "from": "drive",
                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                "sheetId": "REEMPLAZAR_NOMBRE_PESTANA",
                "includesHeaders": true,
                "tableFirstRow": "A1:Z1",
                "filter": [
                    [
                        {
                            "a": "H",
                            "b": "PENDIENTE",
                            "o": "text:equal"
                        }
                    ]
                ],
                "sortOrder": "asc",
                "limit": 200
            },
            "metadata": {
                "designer": { "x": 0, "y": 0 },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Google (Sheets)" }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "variables": [
                    {
                        "name": "dias_impago",
                        "value": "{{floor((now - parseDate(1.`4`; \"YYYY-MM-DD\")) / 86400000)}}"
                    },
                    {
                        "name": "hoy",
                        "value": "{{formatDate(now; \"YYYY-MM-DD\")}}"
                    }
                ],
                "scope": "roundtrip"
            },
            "metadata": { "designer": { "x": 300, "y": 0 } }
        },
        {
            "id": 3,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": { "designer": { "x": 600, "y": 0 } },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 4,
                            "module": "google-email:sendAnEmail",
                            "version": 4,
                            "parameters": { "__IMTCONN__": 0 },
                            "filter": {
                                "name": "Datos incompletos (sin email)",
                                "conditions": [
                                    [
                                        { "a": "{{1.`2`}}", "b": "", "o": "text:equal" }
                                    ]
                                ]
                            },
                            "mapper": {
                                "to": ["REEMPLAZAR_EMAIL_INTERNO@tu-empresa.com"],
                                "subject": "[REVISION] Factura {{1.`0`}} sin datos de contacto",
                                "bodyType": "rawHtml",
                                "content": "<p>La factura <b>{{1.`0`}}</b> de <b>{{1.`1`}}</b> ({{formatNumber(1.`5`; 2; \",\"; \".\")}} EUR) esta impagada pero <b>no tiene email de contacto</b>. No se ha enviado ningun recordatorio automatico. Revisa y completa los datos del cliente manualmente.</p><p>Se ha marcado la factura como REVISION_MANUAL en la hoja de seguimiento.</p>",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": { "x": 900, "y": -450 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Gmail" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 5,
                            "module": "google-sheets:updateRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "REEMPLAZAR_NOMBRE_PESTANA",
                                "tableFirstRow": "A1:Z1",
                                "rowNumber": "{{1.__ROW_NUMBER__}}",
                                "values": {
                                    "0": "{{1.`0`}}",
                                    "1": "{{1.`1`}}",
                                    "2": "{{1.`2`}}",
                                    "3": "{{1.`3`}}",
                                    "4": "{{1.`4`}}",
                                    "5": "{{1.`5`}}",
                                    "6": "{{1.`6`}}",
                                    "7": "REVISION_MANUAL",
                                    "8": "{{1.`8`}}",
                                    "9": "{{1.`9`}}",
                                    "10": "{{1.`10`}}",
                                    "11": "REVISION: falta email de contacto ({{2.hoy}})"
                                },
                                "valueInputOption": "USER_ENTERED"
                            },
                            "metadata": {
                                "designer": { "x": 1200, "y": -450 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Google (Sheets)" }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 6,
                            "module": "openai-gpt-3:CreateCompletion",
                            "version": 1,
                            "parameters": { "__IMTCONN__": 0 },
                            "filter": {
                                "name": "Amable (recordatorio 1)",
                                "conditions": [
                                    [
                                        { "a": "{{1.`2`}}", "b": "", "o": "text:notequal" },
                                        { "a": "{{1.`9`}}", "b": "0", "o": "text:equal" },
                                        { "a": "{{2.dias_impago}}", "b": "7", "o": "number:greaterorequal" },
                                        { "a": "{{1.`8`}}", "b": "{{2.hoy}}", "o": "text:notequal" }
                                    ]
                                ]
                            },
                            "mapper": {
                                "select": "chat",
                                "model": "gpt-4o",
                                "temperature": 0.5,
                                "top_p": 1,
                                "max_tokens": 700,
                                "n_completions": 1,
                                "messages": [
                                    { "role": "system", "content": "PEGAR AQUI el system prompt de prompts/system-prompt-recordatorios.md" },
                                    { "role": "user", "content": "FASE: AMABLE\n\nDatos:\n- Empresa que reclama (firma): REEMPLAZAR_NOMBRE_EMPRESA\n- Cliente: {{1.`1`}}\n- Nº de factura: {{1.`0`}}\n- Concepto del servicio prestado: {{1.`6`}}\n- Importe pendiente: {{formatNumber(1.`5`; 2; \",\"; \".\")}} €\n- Fecha de emisión: {{1.`4`}}\n- Días de retraso: {{2.dias_impago}}\n- Enlace de pago (vacío si no hay): {{1.`10`}}\n\nRedacta el cuerpo HTML del email siguiendo la FASE." }
                                ]
                            },
                            "metadata": {
                                "designer": { "x": 900, "y": -150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion OpenAI" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 7,
                            "module": "google-email:sendAnEmail",
                            "version": 4,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "to": ["{{1.`2`}}"],
                                "subject": "Recordatorio de pago · Factura {{1.`0`}} · {{formatNumber(1.`5`; 2; \",\"; \".\")}} €",
                                "bodyType": "rawHtml",
                                "content": "{{6.result}}",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": { "x": 1200, "y": -150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Gmail (en produccion: WhatsApp/Twilio)" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 8,
                            "module": "google-sheets:updateRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "REEMPLAZAR_NOMBRE_PESTANA",
                                "tableFirstRow": "A1:Z1",
                                "rowNumber": "{{1.__ROW_NUMBER__}}",
                                "values": {
                                    "0": "{{1.`0`}}",
                                    "1": "{{1.`1`}}",
                                    "2": "{{1.`2`}}",
                                    "3": "{{1.`3`}}",
                                    "4": "{{1.`4`}}",
                                    "5": "{{1.`5`}}",
                                    "6": "{{1.`6`}}",
                                    "7": "PENDIENTE",
                                    "8": "{{2.hoy}}",
                                    "9": "1",
                                    "10": "{{1.`10`}}",
                                    "11": "Recordatorio amable enviado {{2.hoy}}"
                                },
                                "valueInputOption": "USER_ENTERED"
                            },
                            "metadata": {
                                "designer": { "x": 1500, "y": -150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Google (Sheets)" }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 9,
                            "module": "openai-gpt-3:CreateCompletion",
                            "version": 1,
                            "parameters": { "__IMTCONN__": 0 },
                            "filter": {
                                "name": "Firme (recordatorio 2)",
                                "conditions": [
                                    [
                                        { "a": "{{1.`2`}}", "b": "", "o": "text:notequal" },
                                        { "a": "{{1.`9`}}", "b": "1", "o": "text:equal" },
                                        { "a": "{{2.dias_impago}}", "b": "15", "o": "number:greaterorequal" },
                                        { "a": "{{1.`8`}}", "b": "{{2.hoy}}", "o": "text:notequal" }
                                    ]
                                ]
                            },
                            "mapper": {
                                "select": "chat",
                                "model": "gpt-4o",
                                "temperature": 0.5,
                                "top_p": 1,
                                "max_tokens": 700,
                                "n_completions": 1,
                                "messages": [
                                    { "role": "system", "content": "PEGAR AQUI el system prompt de prompts/system-prompt-recordatorios.md" },
                                    { "role": "user", "content": "FASE: FIRME\n\nDatos:\n- Empresa que reclama (firma): REEMPLAZAR_NOMBRE_EMPRESA\n- Cliente: {{1.`1`}}\n- Nº de factura: {{1.`0`}}\n- Concepto del servicio prestado: {{1.`6`}}\n- Importe pendiente: {{formatNumber(1.`5`; 2; \",\"; \".\")}} €\n- Fecha de emisión: {{1.`4`}}\n- Días de retraso: {{2.dias_impago}}\n- Enlace de pago (vacío si no hay): {{1.`10`}}\n\nRedacta el cuerpo HTML del email siguiendo la FASE." }
                                ]
                            },
                            "metadata": {
                                "designer": { "x": 900, "y": 150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion OpenAI" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 10,
                            "module": "google-email:sendAnEmail",
                            "version": 4,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "to": ["{{1.`2`}}"],
                                "subject": "2.º aviso · Factura {{1.`0`}} vencida ({{2.dias_impago}} días) · {{formatNumber(1.`5`; 2; \",\"; \".\")}} €",
                                "bodyType": "rawHtml",
                                "content": "{{9.result}}",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": { "x": 1200, "y": 150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Gmail (en produccion: WhatsApp/Twilio)" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 11,
                            "module": "google-sheets:updateRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "REEMPLAZAR_NOMBRE_PESTANA",
                                "tableFirstRow": "A1:Z1",
                                "rowNumber": "{{1.__ROW_NUMBER__}}",
                                "values": {
                                    "0": "{{1.`0`}}",
                                    "1": "{{1.`1`}}",
                                    "2": "{{1.`2`}}",
                                    "3": "{{1.`3`}}",
                                    "4": "{{1.`4`}}",
                                    "5": "{{1.`5`}}",
                                    "6": "{{1.`6`}}",
                                    "7": "PENDIENTE",
                                    "8": "{{2.hoy}}",
                                    "9": "2",
                                    "10": "{{1.`10`}}",
                                    "11": "Segundo aviso (firme) enviado {{2.hoy}}"
                                },
                                "valueInputOption": "USER_ENTERED"
                            },
                            "metadata": {
                                "designer": { "x": 1500, "y": 150 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Google (Sheets)" }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 12,
                            "module": "openai-gpt-3:CreateCompletion",
                            "version": 1,
                            "parameters": { "__IMTCONN__": 0 },
                            "filter": {
                                "name": "Escalado interno (+30 dias)",
                                "conditions": [
                                    [
                                        { "a": "{{1.`9`}}", "b": "2", "o": "text:equal" },
                                        { "a": "{{2.dias_impago}}", "b": "30", "o": "number:greaterorequal" },
                                        { "a": "{{1.`8`}}", "b": "{{2.hoy}}", "o": "text:notequal" }
                                    ]
                                ]
                            },
                            "mapper": {
                                "select": "chat",
                                "model": "gpt-4o",
                                "temperature": 0.4,
                                "top_p": 1,
                                "max_tokens": 700,
                                "n_completions": 1,
                                "messages": [
                                    { "role": "system", "content": "PEGAR AQUI el system prompt de prompts/system-prompt-recordatorios.md" },
                                    { "role": "user", "content": "FASE: ESCALADO_INTERNO\n\nEste mensaje es INTERNO, para el responsable del negocio (no para el cliente).\n\nDatos del caso:\n- Cliente: {{1.`1`}} ({{1.`2`}} · {{1.`3`}})\n- Nº de factura: {{1.`0`}}\n- Concepto: {{1.`6`}}\n- Importe pendiente: {{formatNumber(1.`5`; 2; \",\"; \".\")}} €\n- Fecha de emisión: {{1.`4`}}\n- Días de retraso: {{2.dias_impago}}\n- Recordatorios ya enviados automáticamente: amable y firme.\n\nRedacta la nota interna de escalado siguiendo la FASE." }
                                ]
                            },
                            "metadata": {
                                "designer": { "x": 900, "y": 450 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion OpenAI" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 13,
                            "module": "google-email:sendAnEmail",
                            "version": 4,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "to": ["REEMPLAZAR_EMAIL_INTERNO@tu-empresa.com"],
                                "subject": "[ACCION] Impago +30 dias para decision · {{1.`1`}} · {{formatNumber(1.`5`; 2; \",\"; \".\")}} €",
                                "bodyType": "rawHtml",
                                "content": "{{12.result}}",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": { "x": 1200, "y": 450 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Gmail" }
                                    }
                                }
                            }
                        },
                        {
                            "id": 14,
                            "module": "google-sheets:updateRow",
                            "version": 2,
                            "parameters": { "__IMTCONN__": 0 },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "REEMPLAZAR_NOMBRE_PESTANA",
                                "tableFirstRow": "A1:Z1",
                                "rowNumber": "{{1.__ROW_NUMBER__}}",
                                "values": {
                                    "0": "{{1.`0`}}",
                                    "1": "{{1.`1`}}",
                                    "2": "{{1.`2`}}",
                                    "3": "{{1.`3`}}",
                                    "4": "{{1.`4`}}",
                                    "5": "{{1.`5`}}",
                                    "6": "{{1.`6`}}",
                                    "7": "PENDIENTE",
                                    "8": "{{2.hoy}}",
                                    "9": "3",
                                    "10": "{{1.`10`}}",
                                    "11": "Escalado al responsable {{2.hoy}} — decision humana"
                                },
                                "valueInputOption": "USER_ENTERED"
                            },
                            "metadata": {
                                "designer": { "x": 1500, "y": 450 },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": { "label": "REEMPLAZAR: conexion Google (Sheets)" }
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orphans": [] },
        "zone": "eu1.make.com"
    }
}
