{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/m/:codigo", "destination": "/index.html" },
    { "source": "/r/:slug", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" } ] },
    { "source": "/(admin|cocina|alta|kit|clientes|demo).html", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/papeles/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=300" } ] }
  ]
}
