{
    "name": "Generador Presupuestos-Contratos · 1 · Generacion + Aprobacion",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 0,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "REEMPLAZAR: crear webhook 'presupuestos-in' tras importar"
                        }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "variables": [
                    {
                        "name": "id_solicitud",
                        "value": "{{formatDate(now; \"YYYYMMDD-HHmmss\")}}-{{1.cliente_email}}"
                    },
                    {
                        "name": "fecha_recepcion",
                        "value": "{{formatDate(now; \"DD/MM/YYYY HH:mm\")}}"
                    },
                    {
                        "name": "canal_entrada",
                        "value": "{{ifempty(1.canal; \"formulario\")}}"
                    }
                ],
                "scope": "roundtrip"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "openai-gpt-3:CreateCompletion",
            "version": 1,
            "parameters": {
                "__IMTCONN__": 0
            },
            "mapper": {
                "select": "chat",
                "model": "gpt-4o",
                "temperature": "0.2",
                "top_p": "1",
                "max_tokens": "4000",
                "n_completions": "1",
                "messages": [
                    {
                        "role": "system",
                        "content": "PEGAR AQUI el system prompt de prompts/system-prompt.md"
                    },
                    {
                        "role": "user",
                        "content": "PEGAR AQUI el user prompt de prompts/user-prompt-template.md . Debe incluir {{1}} (datos del webhook), las reglas de negocio y el esquema de salida JSON."
                    }
                ],
                "additionalParameters": [
                    {
                        "key": "response_format",
                        "type": "any",
                        "value": {
                            "type": "json_object"
                        }
                    }
                ]
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "REEMPLAZAR: conexion OpenAI"
                        }
                    }
                }
            }
        },
        {
            "id": 4,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": {
                "type": ""
            },
            "mapper": {
                "json": "{{3.result}}"
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                }
            }
        },
        {
            "id": 5,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 6,
                            "module": "google-email:ActionSendEmail",
                            "version": 1,
                            "parameters": {
                                "account": 0
                            },
                            "filter": {
                                "name": "Faltan datos",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{4.estado}}",
                                            "b": "FALTAN_DATOS",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "to": ["REEMPLAZAR_EMAIL_INTERNO@tu-agencia.com"],
                                "subject": "[ACCION] Faltan datos para generar documento · {{2.id_solicitud}}",
                                "html": "<p>No se ha podido generar el documento automaticamente. Faltan o son ambiguos estos datos:</p><ul><li>{{join(4.campos_faltantes; \"</li><li>\")}}</li></ul><p><b>Notas de la IA:</b> {{4.notas_internas}}</p><p><b>Datos recibidos:</b><br>{{1}}</p>",
                                "attachments": []
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": -150
                                },
                                "restore": {
                                    "parameters": {
                                        "account": {
                                            "label": "REEMPLAZAR: conexion Gmail"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 7,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": {
                                "__IMTCONN__": 0
                            },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "Seguimiento",
                                "tableFirstRow": "A1:Z1",
                                "values": {
                                    "0": "{{2.id_solicitud}}",
                                    "1": "{{2.fecha_recepcion}}",
                                    "2": "{{4.cliente_nombre}}",
                                    "3": "{{1.cliente_email}}",
                                    "4": "{{4.tipo_documento}}",
                                    "5": "",
                                    "6": "",
                                    "7": "PENDIENTE_DATOS",
                                    "8": "{{2.canal_entrada}}",
                                    "9": "",
                                    "10": "",
                                    "11": "{{join(4.campos_faltantes; \", \")}}"
                                }
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1800,
                                    "y": -150
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "label": "REEMPLAZAR: conexion Google Sheets"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 8,
                            "module": "google-docs:createADocumentFromTemplate",
                            "version": 1,
                            "parameters": {
                                "__IMTCONN__": 0
                            },
                            "filter": {
                                "name": "Datos completos",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{4.estado}}",
                                            "b": "COMPLETO",
                                            "o": "text:equal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "select": "map",
                                "document": "REEMPLAZAR_TEMPLATE_DOC_ID",
                                "name": "{{4.tipo_documento}} · {{4.cliente_nombre}} · {{2.id_solicitud}}",
                                "destination": "drive",
                                "folderId": "REEMPLAZAR_FOLDER_ID_GENERADOS",
                                "requests": [
                                    {"text": "cliente_nombre", "replaceText": "{{4.cliente_nombre}}"},
                                    {"text": "cliente_direccion", "replaceText": "{{4.cliente_direccion}}"},
                                    {"text": "cliente_telefono", "replaceText": "{{4.cliente_telefono}}"},
                                    {"text": "cliente_email", "replaceText": "{{4.cliente_email}}"},
                                    {"text": "id_solicitud", "replaceText": "{{2.id_solicitud}}"},
                                    {"text": "proyecto_titulo", "replaceText": "{{4.proyecto_titulo}}"},
                                    {"text": "fecha_documento", "replaceText": "{{4.fecha_documento}}"},
                                    {"text": "validez_dias", "replaceText": "{{4.validez_dias}}"},
                                    {"text": "cuerpo_documento", "replaceText": "{{4.cuerpo_documento}}"},
                                    {"text": "base_imponible", "replaceText": "{{formatNumber(4.base_imponible; 2; \",\"; \".\")}}"},
                                    {"text": "iva_porcentaje", "replaceText": "{{4.iva_porcentaje}}"},
                                    {"text": "iva_importe", "replaceText": "{{formatNumber(4.iva_importe; 2; \",\"; \".\")}}"},
                                    {"text": "total", "replaceText": "{{formatNumber(4.total; 2; \",\"; \".\")}}"},
                                    {"text": "condiciones_pago", "replaceText": "{{4.condiciones_pago}}"},
                                    {"text": "plazo_ejecucion", "replaceText": "{{4.plazo_ejecucion}}"}
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": 150
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "label": "REEMPLAZAR: conexion Google Docs"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 9,
                            "module": "google-docs:exportADocument",
                            "version": 1,
                            "parameters": {
                                "__IMTCONN__": 0
                            },
                            "mapper": {
                                "destination": "drive",
                                "document": "{{8.id}}",
                                "mimeType": "application/pdf"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1800,
                                    "y": 150
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "label": "REEMPLAZAR: conexion Google Docs"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 10,
                            "module": "google-email:ActionSendEmail",
                            "version": 1,
                            "parameters": {
                                "account": 0
                            },
                            "mapper": {
                                "to": ["REEMPLAZAR_EMAIL_INTERNO@tu-agencia.com"],
                                "subject": "[APROBAR] {{4.tipo_documento}} · {{4.cliente_nombre}} · {{4.total}} EUR",
                                "html": "<p>Documento generado y pendiente de tu aprobacion antes de enviarlo al cliente.</p><p><b>Cliente:</b> {{4.cliente_nombre}} ({{4.cliente_email}})<br><b>Proyecto:</b> {{4.proyecto_titulo}}<br><b>Total:</b> {{4.total}} EUR</p><p><b>Notas de la IA:</b> {{4.notas_internas}}</p><p>Revisa el PDF adjunto y pulsa una opcion:</p><p><a href=\"https://hook.eu1.make.com/REEMPLAZAR_HOOK_APROBACION?id_solicitud={{2.id_solicitud}}&decision=aprobar&doc_id={{8.id}}&cliente_email={{4.cliente_email}}\" style=\"background:#1a7f37;color:#fff;padding:10px 18px;text-decoration:none;border-radius:6px\">APROBAR Y ENVIAR</a>&nbsp;&nbsp;<a href=\"https://hook.eu1.make.com/REEMPLAZAR_HOOK_APROBACION?id_solicitud={{2.id_solicitud}}&decision=rechazar&doc_id={{8.id}}&cliente_email={{4.cliente_email}}\" style=\"background:#cf222e;color:#fff;padding:10px 18px;text-decoration:none;border-radius:6px\">RECHAZAR</a></p>",
                                "attachments": [
                                    {
                                        "fileName": "{{4.tipo_documento}}-{{4.cliente_nombre}}.pdf",
                                        "data": "{{9.data}}"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 2100,
                                    "y": 150
                                },
                                "restore": {
                                    "parameters": {
                                        "account": {
                                            "label": "REEMPLAZAR: conexion Gmail"
                                        }
                                    }
                                }
                            }
                        },
                        {
                            "id": 11,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": {
                                "__IMTCONN__": 0
                            },
                            "mapper": {
                                "mode": "map",
                                "spreadsheetId": "REEMPLAZAR_SPREADSHEET_ID",
                                "sheetId": "Seguimiento",
                                "tableFirstRow": "A1:Z1",
                                "values": {
                                    "0": "{{2.id_solicitud}}",
                                    "1": "{{2.fecha_recepcion}}",
                                    "2": "{{4.cliente_nombre}}",
                                    "3": "{{4.cliente_email}}",
                                    "4": "{{4.tipo_documento}}",
                                    "5": "{{4.proyecto_titulo}}",
                                    "6": "{{4.total}}",
                                    "7": "PENDIENTE_APROBACION",
                                    "8": "{{2.canal_entrada}}",
                                    "9": "{{8.webViewLink}}",
                                    "10": "",
                                    "11": "{{4.notas_internas}}"
                                }
                            },
                            "metadata": {
                                "designer": {
                                    "x": 2400,
                                    "y": 150
                                },
                                "restore": {
                                    "parameters": {
                                        "__IMTCONN__": {
                                            "label": "REEMPLAZAR: conexion Google Sheets"
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com"
    }
}
